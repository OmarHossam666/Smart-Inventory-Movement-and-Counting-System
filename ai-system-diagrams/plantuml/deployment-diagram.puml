@startuml
' Smart Inventory Movement & Counting System
' Deliverable 7 — Architecture View 3: Deployment Architecture Diagram
' Sources: capacitor.config.ts, firebase.json, package.json, firestore.rules
' UML 2.5 Strict Deployment Nodes, Artifacts, Execution Environments & Network Topology

title Smart Inventory — Physical Deployment Architecture & Network Topology

skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI", "Helvetica", sans-serif
skinparam defaultFontSize 11

skinparam node {
    BackgroundColor #F8FAFC
    BorderColor #334155
    BorderThickness 1.2
    FontColor #0F172A
    FontSize 11
    FontStyle bold
}

skinparam artifact {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    FontColor #1E3A8A
    FontSize 10
}

skinparam database {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    FontColor #78350F
    FontSize 10
}

skinparam cloud {
    BackgroundColor #F1F5F9
    BorderColor #64748B
    FontColor #1E293B
    FontSize 12
    FontStyle bold
}

' ─── Node 1: Butcher Workstation ─────────────────────────────────
node "Butcher Workstation (Terminal 1)\n<<Android 11+ Touch POS / Tablet>>" as ButcherNode {
    node "Execution Environment:\nAndroid OS (ARM64) + WebView 120+" as ButcherOS {
        artifact "app-release.apk\n[com.smartinventory.butcher]\n(Capacitor 8.0 Hybrid App)" as ButcherApk
        database "Local Encrypted SQLite DB\n[smart_inventory.db]\n(AES-256 via Capacitor SQLite)" as ButcherSqlite
        ButcherApk --> ButcherSqlite : Read / Write
    }
}

' ─── Node 2: Restaurant Kitchen Workstation ─────────────────────
node "Restaurant Workstation (Terminal 2)\n<<Android Tablet / Web POS Terminal>>" as RestaurantNode {
    node "Execution Environment:\nAndroid WebView or Desktop Browser" as RestaurantOS {
        artifact "app-release.apk / Web SPA\n(React 19 + Vite 8 Bundle)\n[HTML5, JS, CSS]" as RestaurantApk
        database "Local DB Engine\n(SQLite or IndexedDB)\n[smart-inventory]" as RestaurantDb
        RestaurantApk --> RestaurantDb : Read / Write
    }
}

' ─── Node 3: Owner Mobile Device / Laptop ───────────────────────
node "Owner Terminal (Supervisor)\n<<Mobile Android/iOS or Laptop>>" as OwnerNode {
    node "Execution Environment:\nChrome / Safari / Edge Desktop / Android" as OwnerOS {
        artifact "Smart Inventory Web Client\n(Vite SPA Dist Bundle)\n[Tailwind CSS v4, React 19]" as OwnerApp
        database "Browser IndexedDB\n[smart-inventory]" as OwnerIdb
        OwnerApp --> OwnerIdb : Read / Write
    }
}

' ─── Node 4: BLE Scale Hardware Peripheral ──────────────────────
node "Bluetooth LE Digital Scale\n<<Hardware Sensor / BLE Peripheral>>" as ScaleNode {
    artifact "Embedded Scale Firmware\n[Weight Service 0x181D]\n[Weight Char 0x2A9D]" as ScaleFw
}

' ─── Node 5: Google Cloud / Firebase Cloud Platform ─────────────
cloud "Google Cloud Platform\nRegion: multi-region (us-central1 / europe-west)" as GoogleCloud {
    
    node "Firebase Hosting (CDN Edge)" as CdnNode {
        artifact "Bundled Web Assets\n[/dist directory]\nindex.html, *.js, *.css" as DistAssets
    }

    node "Firebase Cloud Firestore Cluster" as FirestoreCluster {
        database "Firestore Distributed Database\nRule: branches/{branchId} isolation\n* keys/ (catalog, counts, PINs)\n* transfers/ (real-time shipments)\n* presence/ (12s heartbeats)\n* audits/ (immutable records)" as CloudDb
    }

    node "Firebase Authentication Gateway" as AuthCluster {
        artifact "Identity Authority\nAnonymous & Email/Password JWTs" as AuthTokens
    }
}

' ─── Node 6: Third-Party Messaging Platform ─────────────────────
cloud "Meta WhatsApp Infrastructure" as WhatsAppPlatform {
    node "WhatsApp Web & App Gateway" as WaNode {
        artifact "wa.me Protocol Endpoint\nhttps://wa.me/?text={encodedPayload}" as WaEndpoint
    }
}

' ─── Physical Network Connections & Protocols ────────────────────
ButcherNode .. ScaleNode : "Bluetooth LE 5.0 (2.4 GHz RF)\nGATT Service 0x181D / Char 0x2A9D\nRange: ~10 meters"

ButcherNode <--> FirestoreCluster : "WSS / HTTPS (TLS 1.3)\nReal-time onSnapshot & 250ms batch writes"
RestaurantNode <--> FirestoreCluster : "WSS / HTTPS (TLS 1.3)\nReal-time onSnapshot & 250ms batch writes"
OwnerNode <--> FirestoreCluster : "WSS / HTTPS (TLS 1.3)\nReal-time audits, analytics & presence"

ButcherNode ..> AuthCluster : "HTTPS / REST\nBranch Auth Token Exchange"
RestaurantNode ..> AuthCluster : "HTTPS / REST\nBranch Auth Token Exchange"
OwnerNode ..> AuthCluster : "HTTPS / REST\nBranch Auth Token Exchange"

CdnNode ..> ButcherNode : "HTTPS (App Bundle Update)"
CdnNode ..> RestaurantNode : "HTTPS (SPA Assets)"
CdnNode ..> OwnerNode : "HTTPS (SPA Assets)"

OwnerNode ..> WaEndpoint : "HTTPS Deep-Link / Android Intent\nWhatsApp Audit Report Dispatch"

@enduml
