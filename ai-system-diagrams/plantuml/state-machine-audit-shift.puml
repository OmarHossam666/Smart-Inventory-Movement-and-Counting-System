@startuml
' Smart Inventory Movement & Counting System
' Deliverable 8 — State Machine Diagram 2: Audit Session & Work Shift Lifecycle
' Sources: src/ShiftSetup.tsx, src/App.tsx, src/data/inventoryDataService.ts, src/models.ts
' UML 2.5 Strict State Machine Diagram with Composite States, Guards, Actions & Transitions

title Smart Inventory — State Machine Diagram\nLifecycle 2: Work Shift & Audit Session (ShiftInfo & AuditRecord)

skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI", "Helvetica", sans-serif
skinparam defaultFontSize 11

skinparam state {
    BackgroundColor #F8FAFC
    BorderColor #334155
    BorderThickness 1.2
    FontColor #0F172A
    FontSize 11
    FontStyle bold
    ArrowColor #1E293B
    ArrowThickness 1.1
}

skinparam note {
    BackgroundColor #FEF9C3
    BorderColor #CA8A04
    FontColor #713F12
    FontSize 10
}

[*] --> Uninitialized

state Uninitialized #F1F5F9 {
    Uninitialized : entry / checkLocalStorageSchemaVersion()
    Uninitialized : do / displayShiftSetupScreen()
}

Uninitialized --> ActiveShift : startShift() [shiftType in ["morning", "evening", "night"] && branchId != null]\n/ createShiftInfo();\nloadCategoryCatalog();\npersistCurrentShiftToLocal()

state ActiveShift #FFFFFF {
    
    [*] --> CountingState
    
    state CountingState #EFF6FF {
        CountingState : entry / loadPreviousBalancesAndCounts()
        CountingState : do / recordCountsViaKeypadScaleOrVoice()
        CountingState : exit / validateSessionCounts()
    }
    
    CountingState --> CountingState : recordCount(itemId, qty)\n/ pushUndoStack();\nupdateVariance();\nevaluateStatusBadge();\nqueueFirestoreSync()
    
    CountingState --> CountingState : undoLastCount() [undoStack.length > 0]\n/ popUndoStack();\nrestorePreviousCount();\nrecalculateVariance()
    
    CountingState --> ReviewingVariance : initiateAuditFinalization()\n/ checkUncountedItems()
    
    state ReviewingVariance #FFF7ED {
        ReviewingVariance : entry / calculateAggregateShrinkage();\nrenderColorCodedVarianceTable()
        ReviewingVariance : do / inspectShortagesAndToleranceBadges()
    }
    
    ReviewingVariance --> CountingState : resumeCounting()\n/ unlockItemEditor()
    
    ReviewingVariance --> SecurityVerification : clickCommitFinalAudit()\n/ promptSecurityPinModal()
    
    state SecurityVerification #FEF3C7 {
        SecurityVerification : entry / initPinKeypad();\nresetFailureCounter()
        SecurityVerification : do / awaitOperatorPinInput()
    }
    
    SecurityVerification --> SecurityVerification : verifyPin(pin) [pinInvalid && failures < 3]\n/ triggerShakeAnimation();\nincrementFailures()
    
    SecurityVerification --> PinLockout : verifyPin(pin) [pinInvalid && failures >= 3]\n/ startLockoutTimer(30s)
    
    state PinLockout #FEF2F2 {
        PinLockout : entry / disableKeypad();\ndisplayLockoutCountdown()
        PinLockout : do / decrementTimer()
    }
    
    PinLockout --> SecurityVerification : lockoutTimerExpired()\n/ resetFailureCounter();\nreEnableKeypad()
    
    SecurityVerification --> CommittedAudit : verifyPin(pin) [pinValid]\n/ compileImmutableAuditRecord();\nsaveToLocalAuditsRepository();\npushAuditToFirestore();\nresetActiveShiftCounters();\narchiveStartingStockForNextShift()
}

state CommittedAudit #F0FDF4 {
    CommittedAudit : entry / unlockPdfAndWhatsAppReporting()\nupdateAuditHistoryList()
    CommittedAudit : do / displayAuditSummaryKPIs()
}

CommittedAudit --> [*] : closeShiftSession()\n/ transitionToShiftSetup()

@enduml
