%% Smart Inventory Movement & Counting System
%% Deliverable 5 — Class Diagram (Mermaid Companion)
%% Sources: src/models.ts, src/storage/repository.ts, src/data/*, src/features/*, src/App.tsx

classDiagram
    direction LR

    %% ── Enums ───────────────────────────────────────────────────
    class DeviceRole {
        <<enumeration>>
        owner
        butcher
        restaurant
    }

    class InventoryLocation {
        <<enumeration>>
        butcher
        restaurant
    }

    class TransferStatus {
        <<enumeration>>
        Sent
        Received
        Discrepancy
        Cancelled
    }

    class StockMovementType {
        <<enumeration>>
        count
        auto_deduct
        waste
        transfer
    }

    %% ── Domain Entities ─────────────────────────────────────────
    class Category {
        +String id
        +String nameAr
        +String slug
        +String icon
        +Number sortOrder
    }

    class RecipeComponent {
        +String rawItemId
        +Number quantity
        +String unit
    }

    class Item {
        +String id
        +String categoryId
        +String nameAr
        +String baseUnit
        +String entryUnit
        +Number unitMultiplier
        +Number toleranceThresholdPercent
        +Number minStockAlert
        +Number costPerBaseUnit
        +Boolean isComposite
        +getExpectedStock() Number
    }

    class StockMovement {
        +String id
        +String itemId
        +StockMovementType movementType
        +Number quantity
        +InventoryLocation sourceLocation
        +InventoryLocation destinationLocation
        +String referenceId
        +String reason
        +String createdAt
        +DeviceRole createdByRole
    }

    class TransferLine {
        +String itemId
        +Number sentQuantity
        +Number receivedQuantity
        +String notes
        +calculateVariance() Number
    }

    class Transfer {
        +String id
        +InventoryLocation fromLocation
        +InventoryLocation toLocation
        +TransferStatus status
        +String discrepancyReason
        +String notes
        +String createdAt
        +DeviceRole createdBy
        +isTerminal() Boolean
    }

    class AuditLine {
        +String itemId
        +Number expectedQuantity
        +Number actualQuantity
        +Number varianceQuantity
        +String status
    }

    class AuditRecord {
        +String id
        +String date
        +String shiftType
        +InventoryLocation location
        +String branchId
        +Number totalItems
        +Number matchedCount
        +Number toleranceCount
        +Number shortageCount
        +Number totalVarianceKg
        +DeviceRole committedBy
    }

    %% ── Storage Architecture ────────────────────────────────────
    class StorageRepository {
        <<interface>>
        +get(key) Promise
        +set(key, value) Promise
        +remove(key) Promise
        +clear() Promise
        +keys() Promise
    }

    class IndexedDbRepository {
        -String dbName
        -String storeName
        +get(key) Promise
        +set(key, value) Promise
        +remove(key) Promise
    }

    class AndroidSqliteRepository {
        -SQLiteConnection sqlite
        -SQLiteDBConnection db
        +get(key) Promise
        +set(key, value) Promise
        +remove(key) Promise
    }

    class InventoryStorage {
        -StorageRepository repo
        -Map cache
        +initialize() Promise
        +getItem(key) Promise
        +setItem(key, value) Promise
    }

    %% ── Service Facade & Cloud Sync ─────────────────────────────
    class InventoryDataService {
        -InventoryStorage storage
        -FirebaseInventorySync syncService
        +getCategories() Promise
        +getItems() Promise
        +saveCount(itemId, count) Promise
        +createTransfer(from, to, lines) Promise
        +receiveTransfer(id, lines, notes) Promise
        +saveAuditRecord(audit) Promise
        +exportBackupJson() Promise
        +importBackupJson(json) Promise
    }

    class FirebaseInventorySync {
        -Firestore db
        -String branchId
        +initialize(branchId) Promise
        +subscribeToKey(key, cb) Function
        +syncKey(key, data) void
        +updatePresence(role, deviceId) Promise
        +resolveConflict(key, local, remote) Any
    }

    %% ── Hardware & Feature Processors ───────────────────────────
    class BleScaleClient {
        -String deviceId
        -Boolean isConnected
        +scanAndConnect() Promise
        +startWeightStream(cb) Promise
        +stopWeightStream() Promise
    }

    class SpeechRecognitionEngine {
        -SpeechRecognition recognition
        +startListening(onRes, onErr) void
        +parseArabicSpeech(text, catalog) Any
    }

    class CompositeInventoryCalculator {
        +autoDeductComponents(dishId, qty, items, stock) List
        +validateRecipe(components, items) Boolean
    }

    class InventoryStatusEvaluator {
        +calculateVariance(actual, expected) Number
        +evaluateStatus(variance, threshold, expected) String
    }

    class PdfReportGenerator {
        +renderCanvasReport(audit, items) Promise
        +exportToPdf(canvases) Promise
        +sharePdfViaWhatsApp(pdfBlob, text) Promise
    }

    %% ── Presentation Controller ─────────────────────────────────
    class AppController {
        +DeviceRole activeRole
        +InventoryLocation currentLocation
        +Map counts
        +List transfers
        +handleCountSubmit(itemId, val) void
        +handleUndo() void
        +handleTransferCreate(lines) void
        +handleAuditCommit() void
    }

    %% ── Relationships ───────────────────────────────────────────
    Category "1" *-- "0..*" Item : categorizes
    Item "1" *-- "0..*" RecipeComponent : composed_of
    Transfer "1" *-- "1..*" TransferLine : contains
    AuditRecord "1" *-- "1..*" AuditLine : contains
    Item "1" <-- "0..*" StockMovement : tracks
    Item "1" <-- "0..*" TransferLine : transfers
    Item "1" <-- "0..*" AuditLine : audits

    IndexedDbRepository ..|> StorageRepository
    AndroidSqliteRepository ..|> StorageRepository
    InventoryStorage o-- StorageRepository : delegates_to

    InventoryDataService o-- InventoryStorage : uses
    InventoryDataService o-- FirebaseInventorySync : syncs_via

    AppController --> InventoryDataService : invokes
    AppController ..> BleScaleClient : consumes
    AppController ..> SpeechRecognitionEngine : consumes
    AppController ..> CompositeInventoryCalculator : invokes
    AppController ..> InventoryStatusEvaluator : evaluates_with
    AppController ..> PdfReportGenerator : exports_via
